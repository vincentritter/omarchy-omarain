#!/bin/sh
set -eu

read_file() {
  if [ -r "$1" ]; then cat "$1"; else echo ""; fi
}

for d in /sys/bus/iio/devices/iio:device*; do
  [ -f "$d/in_accel_x_raw" ] || continue
  xr=$(read_file "$d/in_accel_x_raw")
  yr=$(read_file "$d/in_accel_y_raw")
  zr=$(read_file "$d/in_accel_z_raw")
  [ -n "$xr" ] && [ -n "$yr" ] && [ -n "$zr" ] || continue
  sx=$(read_file "$d/in_accel_x_scale")
  sy=$(read_file "$d/in_accel_y_scale")
  sz=$(read_file "$d/in_accel_z_scale")
  [ -n "$sx" ] || sx=$(read_file "$d/in_accel_scale")
  [ -n "$sy" ] || sy=$sx
  [ -n "$sz" ] || sz=$sx
  [ -n "$sx" ] || sx=1
  [ -n "$sy" ] || sy=1
  [ -n "$sz" ] || sz=1
  awk -v xr="$xr" -v yr="$yr" -v zr="$zr" -v sx="$sx" -v sy="$sy" -v sz="$sz" \
    'BEGIN { printf "%.4f %.4f %.4f\n", xr*sx, yr*sy, zr*sz }'
  exit 0
done

for f in /sys/devices/platform/applesmc.*/position; do
  [ -r "$f" ] || continue
  awk '
    {
      gsub(/[()]/, "")
      n = split($0, a, ",")
      if (n >= 3) {
        g = 256.0
        printf "%.4f %.4f %.4f\n", a[1]/g*9.81, a[2]/g*9.81, a[3]/g*9.81
        found = 1
      }
    }
    END { exit found ? 0 : 1 }
  ' "$f" && exit 0
done

exit 1
